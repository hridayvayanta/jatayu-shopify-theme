{%- comment -%}
  JATAYU Luxury Fashion Product Card
  Includes front image, back hover image flip (if available), Quick Add, swatches, and INR price
{%- endcomment -%}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured_media = product.featured_media | default: product.media[0]
  assign secondary_media = product.media[1]
-%}

<article class="product-card" data-product-id="{{ product.id }}">
  <div class="product-card-media">
    <a href="{{ product.url }}" class="product-card-link-media" aria-label="{{ product.title | escape }}">
      {%- if featured_media != blank -%}
        <img
          src="{{ featured_media | image_url: width: 800 }}"
          alt="{{ featured_media.alt | default: product.title | escape }}"
          class="product-card-img product-card-img-primary"
          loading="lazy"
          width="400"
          height="500"
        >
      {%- else -%}
        <div class="product-card-img placeholder-svg-wrap" style="background: var(--color-beige-sand); display: flex; align-items: center; justify-content: center; height: 100%;">
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        </div>
      {%- endif -%}

      {%- if secondary_media != blank -%}
        <img
          src="{{ secondary_media | image_url: width: 800 }}"
          alt="{{ secondary_media.alt | default: product.title | escape }}"
          class="product-card-img product-card-img-secondary"
          loading="lazy"
          width="400"
          height="500"
        >
      {%- endif -%}
    </a>

    {%- if product.available == false -%}
      <span class="product-badge">Sold Out</span>
    {%- elsif product.tags contains 'new' or product.tags contains 'New' -%}
      <span class="product-badge">New Chapter</span>
    {%- elsif product.compare_at_price > product.price -%}
      <span class="product-badge">Sale</span>
    {%- endif -%}

    {%- if product.available and current_variant != blank -%}
      <button
        type="button"
        class="quick-add-btn"
        data-variant-id="{{ current_variant.id }}"
        aria-label="Quick Add {{ product.title | escape }}"
      >
        {% render 'icon-bag' %}
        <span>Quick Add</span>
      </button>
    {%- endif -%}
  </div>

  <div class="product-card-info">
    <h3 class="product-card-title">
      <a href="{{ product.url }}">{{ product.title }}</a>
    </h3>

    <div class="product-card-price">
      {{ product.price | money }}
    </div>

    {%- comment -%} Color swatches if product has color options {%- endcomment -%}
    {%- for option in product.options_with_values -%}
      {%- assign downcase_name = option.name | downcase -%}
      {%- if downcase_name contains 'color' or downcase_name contains 'colour' -%}
        <div class="product-card-swatches" aria-label="Available Colors">
          {%- for value in option.values -%}
            {%- assign swatch_color = '#211B19' -%}
            {%- assign val_down = value | downcase -%}
            {%- if val_down contains 'maroon' -%}{%- assign swatch_color = '#740101' -%}{%- endif -%}
            {%- if val_down contains 'ivory' or val_down contains 'cream' or val_down contains 'white' -%}{%- assign swatch_color = '#F7DBBD' -%}{%- endif -%}
            {%- if val_down contains 'sand' or val_down contains 'beige' -%}{%- assign swatch_color = '#E9C39E' -%}{%- endif -%}
            {%- if val_down contains 'charcoal' or val_down contains 'black' -%}{%- assign swatch_color = '#211B19' -%}{%- endif -%}
            <span class="swatch-dot" style="background-color: {{ swatch_color }};" title="{{ value | escape }}"></span>
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</article>
