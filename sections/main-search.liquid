{%- comment -%}
  JATAYU Luxury Fashion — Search Results Section
{%- endcomment -%}

<section class="search-page-section" style="padding: clamp(60px, 8vw, 120px) 0; margin-top: var(--header-height);">
  <div class="page-width">
    <div style="max-width: 720px; margin: 0 auto 48px; text-align: center;">
      <span class="label-eyebrow">ARCHIVE DISCOVERY</span>
      <h1 class="heading-section" style="color: var(--color-maroon-primary); margin-bottom: 24px;">Search JATAYU</h1>

      <form action="{{ routes.search_url }}" method="get" role="search" style="display: flex; gap: 12px; border-bottom: 2px solid var(--color-maroon-primary); padding-bottom: 8px;">
        <input
          type="search"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="Search garments, hoodies, tees..."
          aria-label="Search store"
          style="flex: 1; border: none; background: transparent; font-size: 16px; font-family: inherit; outline: none; color: var(--color-text-body);"
        >
        <button type="submit" class="btn btn-primary" style="padding: 10px 24px;">Search</button>
      </form>
    </div>

    {%- if search.performed -%}
      {%- if search.results_count > 0 -%}
        <p style="text-align: center; margin-bottom: 36px; font-size: 14px; color: rgba(33, 27, 25, 0.7);">
          Showing {{ search.results_count }} result{% if search.results_count != 1 %}s{% endif %} for "{{ search.terms }}"
        </p>
        <div class="product-grid">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', product: item %}
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- else -%}
        <div style="text-align: center; padding: 48px 0;">
          <h2 style="font-family: var(--font-editorial); font-size: 28px; margin-bottom: 12px; color: var(--color-maroon-primary);">No pieces found</h2>
          <p style="color: rgba(33, 27, 25, 0.7); margin-bottom: 24px;">We could not locate any pieces matching "{{ search.terms }}".</p>
          <a href="/collections/all" class="btn btn-secondary">Explore All Pieces</a>
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Search Page",
  "settings": []
}
{% endschema %}
