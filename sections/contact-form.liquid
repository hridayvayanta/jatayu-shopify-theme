{%- comment -%}
  JATAYU Luxury Fashion — Contact Form Section
  Standard Shopify contact form integration
{%- endcomment -%}

<section class="contact-page-section" style="padding: clamp(60px, 8vw, 120px) 0; margin-top: var(--header-height);">
  <div class="page-width">
    <div style="max-width: 680px; margin: 0 auto;">
      <div style="text-align: center; margin-bottom: 48px;">
        <span class="label-eyebrow">CONCIERGE & INQUIRIES</span>
        <h1 class="heading-section" style="color: var(--color-maroon-primary); margin-bottom: 16px;">
          {{ section.settings.heading | default: 'Get in Touch' }}
        </h1>
        <p style="color: rgba(33, 27, 25, 0.8); font-size: 15px;">
          We welcome inquiries regarding orders, sizing, bespoke requests, and collaborations.
        </p>
      </div>

      {%- form 'contact', id: 'ContactForm', class: 'contact-form' -%}
        {%- if form.posted_successfully? -%}
          <div style="background: rgba(116, 1, 1, 0.08); border: 1px solid var(--color-maroon-primary); padding: 16px; margin-bottom: 24px; text-align: center; font-weight: 500;">
            Thank you for reaching out. A representative will respond shortly.
          </div>
        {%- elsif form.errors -%}
          <div style="background: rgba(153, 11, 5, 0.08); border: 1px solid var(--color-maroon-hover); padding: 16px; margin-bottom: 24px; color: var(--color-maroon-hover);">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
          <div>
            <label for="ContactFormName" style="display: block; font-size: 12px; text-transform: uppercase; letter-spacing: 0.1em; font-weight: 600; margin-bottom: 8px;">Name</label>
            <input type="text" id="ContactFormName" name="contact[name]" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}" style="width: 100%; padding: 14px 16px; background: var(--color-offwhite); border: 1px solid var(--color-border-subtle); outline: none; font-family: inherit;" required>
          </div>
          <div>
            <label for="ContactFormEmail" style="display: block; font-size: 12px; text-transform: uppercase; letter-spacing: 0.1em; font-weight: 600; margin-bottom: 8px;">Email</label>
            <input type="email" id="ContactFormEmail" name="contact[email]" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}" style="width: 100%; padding: 14px 16px; background: var(--color-offwhite); border: 1px solid var(--color-border-subtle); outline: none; font-family: inherit;" required>
          </div>
        </div>

        <div style="margin-bottom: 20px;">
          <label for="ContactFormPhone" style="display: block; font-size: 12px; text-transform: uppercase; letter-spacing: 0.1em; font-weight: 600; margin-bottom: 8px;">Phone (Optional)</label>
          <input type="tel" id="ContactFormPhone" name="contact[phone]" value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}" style="width: 100%; padding: 14px 16px; background: var(--color-offwhite); border: 1px solid var(--color-border-subtle); outline: none; font-family: inherit;">
        </div>

        <div style="margin-bottom: 24px;">
          <label for="ContactFormMessage" style="display: block; font-size: 12px; text-transform: uppercase; letter-spacing: 0.1em; font-weight: 600; margin-bottom: 8px;">Message</label>
          <textarea id="ContactFormMessage" name="contact[body]" rows="5" style="width: 100%; padding: 14px 16px; background: var(--color-offwhite); border: 1px solid var(--color-border-subtle); outline: none; font-family: inherit;" required>{{ form.body }}</textarea>
        </div>

        <button type="submit" class="btn btn-primary" style="width: 100%;">Send Inquiry</button>
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact Form",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get in Touch"
    }
  ]
}
{% endschema %}
