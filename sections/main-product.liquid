{%- comment -%}
  JATAYU Luxury Fashion — Main Product Section
  Shopify Online Store 2.0 Product Detail Page
  Full variant selection (Size & Color), Qikink fulfillment compatibility,
  Gallery thumbnail navigation, Ajax Add to Bag with loading state, and Accordion specs.
{%- endcomment -%}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured_media = current_variant.featured_media | default: product.featured_media | default: product.media[0]
-%}

<section class="pdp-section" id="MainProductSection" data-section-id="{{ section.id }}">
  <div class="page-width">
    <div class="pdp-grid">
      <!-- Left: Product Media Gallery -->
      <div class="pdp-gallery">
        <div class="pdp-main-image-wrap">
          {%- if featured_media != blank -%}
            <img
              src="{{ featured_media | image_url: width: 1400 }}"
              alt="{{ featured_media.alt | default: product.title | escape }}"
              class="pdp-main-image"
              id="PdpMainImage"
              width="700"
              height="875"
            >
          {%- else -%}
            <div class="pdp-main-image placeholder-image" style="background: var(--color-beige-sand); display: flex; align-items: center; justify-content: center; min-height: 500px;">
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {%- endif -%}
        </div>

        <!-- Gallery Thumbnails -->
        {%- if product.media.size > 1 -%}
          <div class="pdp-thumbnails">
            {%- for media in product.media -%}
              <img
                src="{{ media | image_url: width: 240 }}"
                data-full-src="{{ media | image_url: width: 1400 }}"
                alt="{{ media.alt | default: product.title | escape }}"
                class="pdp-thumb {% if forloop.first %}is-active{% endif %}"
                width="80"
                height="100"
              >
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <!-- Right: Product Purchase & Details -->
      <div class="pdp-details">
        <div>
          {%- if product.vendor != blank -%}
            <span class="label-eyebrow">{{ product.vendor }}</span>
          {%- else -%}
            <span class="label-eyebrow">{{ shop.name }}</span>
          {%- endif -%}
          <h1 class="pdp-title">{{ product.title }}</h1>
        </div>

        <div class="pdp-price" id="PdpPrice">
          {{ current_variant.price | default: product.price | money }}
        </div>

        <!-- Add to Bag Form -->
        {%- form 'product', product, id: 'pdp-add-form', class: 'pdp-form' -%}
          <input type="hidden" name="id" id="selected-variant-id" value="{{ current_variant.id }}">

          <div class="pdp-variants">
            {%- unless product.has_only_default_variant -%}
              {%- for option in product.options_with_values -%}
                <div style="margin-bottom: 20px;">
                  <div class="variant-label-row">
                    <span>Select {{ option.name }}</span>
                  </div>
                  <div class="variant-options-row" role="radiogroup" aria-label="{{ option.name }}">
                    {%- for value in option.values -%}
                      {%- assign is_selected = false -%}
                      {%- if option.selected_value == value -%}
                        {%- assign is_selected = true -%}
                      {%- elsif forloop.first and option.selected_value == blank -%}
                        {%- assign is_selected = true -%}
                      {%- endif -%}
                      <button
                        type="button"
                        class="size-option-btn {% if is_selected %}is-selected{% endif %}"
                        data-option-index="{{ option.position }}"
                        data-value="{{ value | escape }}"
                        role="radio"
                        aria-checked="{% if is_selected %}true{% else %}false{% endif %}"
                      >
                        {{ value }}
                      </button>
                    {%- endfor -%}
                  </div>
                </div>
              {%- endfor -%}
            {%- endunless -%}
          </div>

          <!-- Quantity Stepper & CTA -->
          <div class="pdp-qty-cta" style="margin-top: 24px;">
            <div class="pdp-qty-stepper">
              <button type="button" class="qty-btn" onclick="const q=this.nextElementSibling; if(q.value>1)q.value--;" aria-label="Decrease quantity">-</button>
              <input type="number" name="quantity" class="qty-input" value="1" min="1" aria-label="Quantity">
              <button type="button" class="qty-btn" onclick="const q=this.previousElementSibling; q.value++;" aria-label="Increase quantity">+</button>
            </div>

            <button
              type="submit"
              name="add"
              class="btn btn-primary pdp-add-btn"
              {% if product.available == false %}disabled{% endif %}
            >
              {%- if product.available == false -%}
                <span>Sold Out</span>
              {%- else -%}
                <span>Add to Bag</span>
              {%- endif -%}
            </button>
          </div>
        {%- endform -%}

        <!-- Product Accordions -->
        <div class="pdp-accordions" style="margin-top: 32px;">
          <!-- Description -->
          <div class="accordion-item is-open">
            <button type="button" class="accordion-trigger" aria-expanded="true">
              <span>Description & Craft</span>
              {% render 'icon-chevron' %}
            </button>
            <div class="accordion-content">
              {%- if product.description != blank -%}
                {{ product.description }}
              {%- else -%}
                <p>Authentic {{ shop.name }} apparel crafted with meticulous detail and premium heritage quality.</p>
              {%- endif -%}
            </div>
          </div>

          <!-- Shipping & Returns -->
          <div class="accordion-item">
            <button type="button" class="accordion-trigger" aria-expanded="false">
              <span>Shipping & Delivery</span>
              {% render 'icon-chevron' %}
            </button>
            <div class="accordion-content">
              <p>Complimentary shipping across India on all prepaid orders. Orders are processed with utmost care and delivered in bespoke luxury packaging within 3-5 business days.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product Details",
  "settings": []
}
{% endschema %}
