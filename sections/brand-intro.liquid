{%- comment -%}
  SECTION 2 — Brand Introduction
  "Wear Your Legacy. Rooted in heritage. Made for today."
{%- endcomment -%}

<section class="brand-intro-section" id="BrandIntroSection" aria-label="Brand Introduction">
  <div class="page-width">
    <div class="brand-intro-inner">
      <span class="label-eyebrow">{{ section.settings.eyebrow | default: 'The Awakening' }}</span>
      <h2 class="brand-intro-title">{{ section.settings.heading | default: 'Wear Your Legacy.' }}</h2>
      <p class="brand-intro-sub">{{ section.settings.subheading | default: 'Rooted in heritage. Made for today.' }}</p>
      <div>
        <a href="{{ section.settings.cta_link | default: '/collections/all' }}" class="btn btn-primary">
          {{ section.settings.cta_text | default: 'EXPLORE THE COLLECTION' }}
        </a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Brand Introduction",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "The Awakening"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Wear Your Legacy."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Rooted in heritage. Made for today."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button Label",
      "default": "EXPLORE THE COLLECTION"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button Link",
      "default": "/collections/all"
    }
  ],
  "presets": [
    {
      "name": "Brand Introduction"
    }
  ]
}
{% endschema %}
