{%- comment -%}
  SECTION 2 — Brand Introduction
  "Wear Your Legacy. Rooted in heritage. Made for today."
{%- endcomment -%}

<section class="brand-intro-section" id="BrandIntroSection" aria-label="Brand Introduction">
  <div class="page-width">
    <div class="brand-intro-inner">
      {%- if section.settings.eyebrow != blank -%}
        <span class="label-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="brand-intro-title">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="brand-intro-sub">{{ section.settings.subheading }}</p>
      {%- endif -%}
      {%- if section.settings.cta_text != blank -%}
        <div>
          <a href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}" class="btn btn-primary">
            {{ section.settings.cta_text }}
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Brand Introduction",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "The Awakening"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Wear Your Legacy."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Rooted in heritage. Made for today."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button Label",
      "default": "EXPLORE THE COLLECTION"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Brand Introduction"
    }
  ]
}
{% endschema %}
