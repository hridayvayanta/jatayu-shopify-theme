{%- comment -%}
  JATAYU Luxury Fashion — 404 Not Found Page Section
{%- endcomment -%}

<section class="not-found-section" style="padding: clamp(80px, 12vw, 160px) 0; margin-top: var(--header-height); text-align: center;">
  <div class="page-width">
    <div style="max-width: 600px; margin: 0 auto;">
      <span class="label-eyebrow">404 ERROR</span>
      <h1 class="display-large" style="color: var(--color-maroon-primary); margin-bottom: 20px;">
        Chapter Not Found
      </h1>
      <p style="color: rgba(33, 27, 25, 0.75); font-size: 16px; margin-bottom: 36px;">
        The passage or garment you are looking for has departed or never existed in our archive.
      </p>
      <a href="{{ routes.root_url }}" class="btn btn-primary">Return to Homepage</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "404 Page",
  "settings": []
}
{% endschema %}
