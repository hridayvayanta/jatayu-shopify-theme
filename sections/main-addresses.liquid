{%- comment -%}
  JATAYU Luxury Fashion — Customer Addresses Management
{%- endcomment -%}

<section class="customer-account-section" style="padding: clamp(60px, 8vw, 120px) 0; margin-top: var(--header-height);">
  <div class="page-width">
    <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--color-border-subtle); padding-bottom: 24px; margin-bottom: 40px;">
      <div>
        <a href="{{ routes.account_url }}" style="font-size: 12px; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-maroon-primary); text-decoration: underline; margin-bottom: 8px; display: inline-block;">
          &larr; Back to Account
        </a>
        <h1 class="heading-section" style="color: var(--color-maroon-primary);">Addresses</h1>
      </div>

      <button type="button" class="btn btn-primary" onclick="document.getElementById('AddAddressModal').style.display='block';">
        Add New Address
      </button>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 24px;">
      {%- for address in customer.addresses -%}
        <div style="background: var(--color-ivory-parchment); border: 1px solid var(--color-border-sand); padding: 28px; border-radius: 4px; position: relative;">
          {%- if address == customer.default_address -%}
            <span style="display: inline-block; font-size: 10px; text-transform: uppercase; letter-spacing: 0.1em; padding: 4px 8px; background: var(--color-maroon-primary); color: var(--color-offwhite); border-radius: 2px; margin-bottom: 12px;">
              Default
            </span>
          {%- endif -%}

          <div style="font-size: 14px; line-height: 1.6; color: var(--color-text-body); margin-bottom: 20px;">
            <p style="font-weight: 600;">{{ address.name }}</p>
            {%- if address.company != blank -%}<p>{{ address.company }}</p>{%- endif -%}
            <p>{{ address.address1 }}</p>
            {%- if address.address2 != blank -%}<p>{{ address.address2 }}</p>{%- endif -%}
            <p>{{ address.city }}, {{ address.province_code }} {{ address.zip }}</p>
            <p>{{ address.country }}</p>
            {%- if address.phone != blank -%}<p style="margin-top: 6px;">{{ address.phone }}</p>{%- endif -%}
          </div>

          <div style="display: flex; gap: 12px;">
            <form class="address-delete-form" method="post" action="/account/addresses/{{ address.id }}" onsubmit="return confirm('Are you sure you wish to delete this address?');">
              <input type="hidden" name="_method" value="delete">
              <button type="submit" class="btn btn-secondary" style="padding: 6px 14px; font-size: 11px;">
                Delete
              </button>
            </form>
          </div>
        </div>
      {%- endfor -%}
    </div>

    <!-- Add New Address Modal / Drawer -->
    <div id="AddAddressModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.6); z-index: 1000; overflow-y: auto; padding: 40px 20px;">
      <div style="max-width: 520px; margin: 40px auto; background: var(--color-ivory-warm); padding: 36px; border-radius: 4px; border: 1px solid var(--color-border-sand);">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
          <h2 style="font-family: var(--font-editorial); font-size: 24px; color: var(--color-maroon-primary);">Add Address</h2>
          <button type="button" onclick="document.getElementById('AddAddressModal').style.display='none';" style="background: none; border: none; font-size: 20px; cursor: pointer;">&times;</button>
        </div>

        {%- form 'customer_address', customer.new_address -%}
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 14px;">
            <div>
              <label style="display: block; font-size: 11px; text-transform: uppercase; margin-bottom: 6px;">First Name</label>
              <input type="text" name="address[first_name]" style="width: 100%; padding: 10px; border: 1px solid var(--color-border-subtle); background: var(--color-ivory-parchment);">
            </div>
            <div>
              <label style="display: block; font-size: 11px; text-transform: uppercase; margin-bottom: 6px;">Last Name</label>
              <input type="text" name="address[last_name]" style="width: 100%; padding: 10px; border: 1px solid var(--color-border-subtle); background: var(--color-ivory-parchment);">
            </div>
          </div>

          <div style="margin-bottom: 14px;">
            <label style="display: block; font-size: 11px; text-transform: uppercase; margin-bottom: 6px;">Address Line 1</label>
            <input type="text" name="address[address1]" required style="width: 100%; padding: 10px; border: 1px solid var(--color-border-subtle); background: var(--color-ivory-parchment);">
          </div>

          <div style="margin-bottom: 14px;">
            <label style="display: block; font-size: 11px; text-transform: uppercase; margin-bottom: 6px;">Address Line 2 (Optional)</label>
            <input type="text" name="address[address2]" style="width: 100%; padding: 10px; border: 1px solid var(--color-border-subtle); background: var(--color-ivory-parchment);">
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 14px;">
            <div>
              <label style="display: block; font-size: 11px; text-transform: uppercase; margin-bottom: 6px;">City</label>
              <input type="text" name="address[city]" required style="width: 100%; padding: 10px; border: 1px solid var(--color-border-subtle); background: var(--color-ivory-parchment);">
            </div>
            <div>
              <label style="display: block; font-size: 11px; text-transform: uppercase; margin-bottom: 6px;">Postal / PIN Code</label>
              <input type="text" name="address[zip]" required style="width: 100%; padding: 10px; border: 1px solid var(--color-border-subtle); background: var(--color-ivory-parchment);">
            </div>
          </div>

          <div style="margin-bottom: 14px;">
            <label style="display: block; font-size: 11px; text-transform: uppercase; margin-bottom: 6px;">Country</label>
            <select name="address[country]" style="width: 100%; padding: 10px; border: 1px solid var(--color-border-subtle); background: var(--color-ivory-parchment);">
              {{ all_country_option_tags }}
            </select>
          </div>

          <div style="margin-bottom: 20px;">
            <label style="display: block; font-size: 11px; text-transform: uppercase; margin-bottom: 6px;">Phone</label>
            <input type="tel" name="address[phone]" style="width: 100%; padding: 10px; border: 1px solid var(--color-border-subtle); background: var(--color-ivory-parchment);">
          </div>

          <div style="margin-bottom: 24px; display: flex; align-items: center; gap: 8px;">
            {{ form.set_as_default_checkbox }}
            <label for="address_default_address_new" style="font-size: 13px;">Set as default sanctuary address</label>
          </div>

          <button type="submit" class="btn btn-primary" style="width: 100%; justify-content: center;">
            Save Address
          </button>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Customer Addresses",
  "settings": []
}
{% endschema %}
