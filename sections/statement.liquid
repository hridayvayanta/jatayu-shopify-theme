{%- comment -%}
  SECTION 5 — Statement Section
  "Not Just Worn. Remembered."
  Oversized Cormorant Garamond typography on Warm Parchment Ivory background
{%- endcomment -%}

<section class="statement-section" id="StatementSection" aria-label="Brand Philosophy">
  <div class="page-width">
    <div class="statement-content">
      <span class="label-eyebrow">{{ section.settings.eyebrow | default: 'THE ETHOS' }}</span>
      <blockquote class="statement-text">
        {{ section.settings.statement_html | default: 'Not Just Worn. <em>Remembered.</em>' }}
      </blockquote>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Statement Section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "THE ETHOS"
    },
    {
      "type": "html",
      "id": "statement_html",
      "label": "Statement HTML (Use <em> for italic word)",
      "default": "Not Just Worn. <em>Remembered.</em>"
    }
  ],
  "presets": [
    {
      "name": "Statement Section"
    }
  ]
}
{% endschema %}
