{%- comment -%}
  JATAYU Luxury Fashion — Customer Login & Password Recovery
{%- endcomment -%}

<section class="customer-account-section" style="padding: clamp(60px, 8vw, 120px) 0; margin-top: var(--header-height);">
  <div class="page-width">
    <div class="customer-auth-container" style="max-width: 480px; margin: 0 auto; background: var(--color-ivory-parchment); border: 1px solid var(--color-border-sand); padding: clamp(32px, 5vw, 48px); border-radius: 4px;">
      
      <!-- Login Form -->
      <div id="CustomerLoginForm">
        <div style="text-align: center; margin-bottom: 32px;">
          <span class="label-eyebrow">SANCTUARY ACCESS</span>
          <h1 class="heading-section" style="color: var(--color-maroon-primary); margin-top: 6px;">Sign In</h1>
          <p style="font-size: 14px; color: rgba(33, 27, 25, 0.7); margin-top: 8px;">Access your private archive and order chronicle.</p>
        </div>

        {%- form 'customer_login', class: 'auth-form' -%}
          {%- if form.errors -%}
            <div class="auth-errors" style="background: rgba(116, 1, 1, 0.08); border-left: 3px solid var(--color-maroon-primary); padding: 12px 16px; margin-bottom: 24px; font-size: 13px; color: var(--color-maroon-primary);">
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}

          <div class="form-group" style="margin-bottom: 20px;">
            <label for="CustomerEmail" class="form-label" style="display: block; font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 8px; font-weight: 600;">Email Address</label>
            <input
              type="email"
              name="customer[email]"
              id="CustomerEmail"
              autocomplete="email"
              autocorrect="off"
              autocapitalize="off"
              required
              class="auth-input"
              style="width: 100%; padding: 12px 16px; border: 1px solid var(--color-border-subtle); background: var(--color-ivory-warm); font-family: inherit; font-size: 14px; color: var(--color-text-body); outline: none; border-radius: 2px;"
            >
          </div>

          {%- if form.password_needed -%}
            <div class="form-group" style="margin-bottom: 24px;">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                <label for="CustomerPassword" class="form-label" style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em; font-weight: 600;">Password</label>
                <a href="#recover" id="RecoverPasswordTrigger" style="font-size: 12px; color: var(--color-maroon-primary); text-decoration: underline;" onclick="document.getElementById('CustomerLoginForm').style.display='none'; document.getElementById('RecoverPasswordForm').style.display='block'; return false;">
                  Forgot password?
                </a>
              </div>
              <input
                type="password"
                name="customer[password]"
                id="CustomerPassword"
                autocomplete="current-password"
                required
                class="auth-input"
                style="width: 100%; padding: 12px 16px; border: 1px solid var(--color-border-subtle); background: var(--color-ivory-warm); font-family: inherit; font-size: 14px; color: var(--color-text-body); outline: none; border-radius: 2px;"
              >
            </div>
          {%- endif -%}

          <button type="submit" class="btn btn-primary" style="width: 100%; justify-content: center;">
            Sign In
          </button>

          <div style="text-align: center; margin-top: 24px; font-size: 13px; color: rgba(33, 27, 25, 0.75);">
            Don't have an account?
            <a href="{{ routes.account_register_url }}" style="color: var(--color-maroon-primary); font-weight: 600; text-decoration: underline; margin-left: 4px;">
              Create one
            </a>
          </div>
        {%- endform -%}
      </div>

      <!-- Password Recovery Form (Hidden by default) -->
      <div id="RecoverPasswordForm" style="display: none;">
        <div style="text-align: center; margin-bottom: 28px;">
          <span class="label-eyebrow">ACCOUNT RECOVERY</span>
          <h2 class="heading-section" style="color: var(--color-maroon-primary); margin-top: 6px; font-size: 26px;">Reset Password</h2>
          <p style="font-size: 13px; color: rgba(33, 27, 25, 0.7); margin-top: 8px;">We will send you an email link to reset your password.</p>
        </div>

        {%- form 'recover_customer_password', class: 'auth-form' -%}
          {%- if form.errors -%}
            <div class="auth-errors" style="background: rgba(116, 1, 1, 0.08); border-left: 3px solid var(--color-maroon-primary); padding: 12px 16px; margin-bottom: 24px; font-size: 13px; color: var(--color-maroon-primary);">
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}

          <div class="form-group" style="margin-bottom: 24px;">
            <label for="RecoverEmail" class="form-label" style="display: block; font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 8px; font-weight: 600;">Email Address</label>
            <input
              type="email"
              name="email"
              id="RecoverEmail"
              autocomplete="email"
              autocorrect="off"
              autocapitalize="off"
              required
              class="auth-input"
              style="width: 100%; padding: 12px 16px; border: 1px solid var(--color-border-subtle); background: var(--color-ivory-warm); font-family: inherit; font-size: 14px; color: var(--color-text-body); outline: none; border-radius: 2px;"
            >
          </div>

          <button type="submit" class="btn btn-primary" style="width: 100%; justify-content: center;">
            Send Reset Link
          </button>

          <div style="text-align: center; margin-top: 20px;">
            <button type="button" class="btn-text-arrow" style="border: none; background: transparent; cursor: pointer;" onclick="document.getElementById('RecoverPasswordForm').style.display='none'; document.getElementById('CustomerLoginForm').style.display='block';">
              Cancel & Return to Sign In
            </button>
          </div>
        {%- endform -%}
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Customer Login",
  "settings": []
}
{% endschema %}
