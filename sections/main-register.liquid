{%- comment -%}
  JATAYU Luxury Fashion — Customer Registration
{%- endcomment -%}

<section class="customer-account-section" style="padding: clamp(60px, 8vw, 120px) 0; margin-top: var(--header-height);">
  <div class="page-width">
    <div class="customer-auth-container" style="max-width: 480px; margin: 0 auto; background: var(--color-ivory-parchment); border: 1px solid var(--color-border-sand); padding: clamp(32px, 5vw, 48px); border-radius: 4px;">
      
      <div style="text-align: center; margin-bottom: 32px;">
        <span class="label-eyebrow">JOIN THE LEGACY</span>
        <h1 class="heading-section" style="color: var(--color-maroon-primary); margin-top: 6px;">Create Account</h1>
        <p style="font-size: 14px; color: rgba(33, 27, 25, 0.7); margin-top: 8px;">Gain entry to limited releases, order tracking, and private drops.</p>
      </div>

      {%- form 'create_customer', class: 'auth-form' -%}
        {%- if form.errors -%}
          <div class="auth-errors" style="background: rgba(116, 1, 1, 0.08); border-left: 3px solid var(--color-maroon-primary); padding: 12px 16px; margin-bottom: 24px; font-size: 13px; color: var(--color-maroon-primary);">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div class="form-group" style="margin-bottom: 16px;">
          <label for="FirstName" class="form-label" style="display: block; font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 8px; font-weight: 600;">First Name</label>
          <input
            type="text"
            name="customer[first_name]"
            id="FirstName"
            autocomplete="given-name"
            class="auth-input"
            style="width: 100%; padding: 12px 16px; border: 1px solid var(--color-border-subtle); background: var(--color-ivory-warm); font-family: inherit; font-size: 14px; color: var(--color-text-body); outline: none; border-radius: 2px;"
          >
        </div>

        <div class="form-group" style="margin-bottom: 16px;">
          <label for="LastName" class="form-label" style="display: block; font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 8px; font-weight: 600;">Last Name</label>
          <input
            type="text"
            name="customer[last_name]"
            id="LastName"
            autocomplete="family-name"
            class="auth-input"
            style="width: 100%; padding: 12px 16px; border: 1px solid var(--color-border-subtle); background: var(--color-ivory-warm); font-family: inherit; font-size: 14px; color: var(--color-text-body); outline: none; border-radius: 2px;"
          >
        </div>

        <div class="form-group" style="margin-bottom: 16px;">
          <label for="CustomerEmail" class="form-label" style="display: block; font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 8px; font-weight: 600;">Email Address</label>
          <input
            type="email"
            name="customer[email]"
            id="CustomerEmail"
            autocomplete="email"
            autocorrect="off"
            autocapitalize="off"
            required
            class="auth-input"
            style="width: 100%; padding: 12px 16px; border: 1px solid var(--color-border-subtle); background: var(--color-ivory-warm); font-family: inherit; font-size: 14px; color: var(--color-text-body); outline: none; border-radius: 2px;"
          >
        </div>

        <div class="form-group" style="margin-bottom: 24px;">
          <label for="CustomerPassword" class="form-label" style="display: block; font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 8px; font-weight: 600;">Password</label>
          <input
            type="password"
            name="customer[password]"
            id="CustomerPassword"
            autocomplete="new-password"
            required
            class="auth-input"
            style="width: 100%; padding: 12px 16px; border: 1px solid var(--color-border-subtle); background: var(--color-ivory-warm); font-family: inherit; font-size: 14px; color: var(--color-text-body); outline: none; border-radius: 2px;"
          >
        </div>

        <button type="submit" class="btn btn-primary" style="width: 100%; justify-content: center;">
          Create Account
        </button>

        <div style="text-align: center; margin-top: 24px; font-size: 13px; color: rgba(33, 27, 25, 0.75);">
          Already have an account?
          <a href="{{ routes.account_login_url }}" style="color: var(--color-maroon-primary); font-weight: 600; text-decoration: underline; margin-left: 4px;">
            Sign in
          </a>
        </div>
      {%- endform -%}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Customer Register",
  "settings": []
}
{% endschema %}
