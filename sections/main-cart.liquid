{%- comment -%}
  JATAYU Luxury Fashion — Full Cart Page Section
{%- endcomment -%}

<section class="main-cart-section" style="padding: clamp(60px, 8vw, 120px) 0; margin-top: var(--header-height);">
  <div class="page-width">
    <div style="max-width: 860px; margin: 0 auto;">
      <h1 class="heading-section" style="color: var(--color-maroon-primary); margin-bottom: 32px; text-align: center;">
        Your Shopping Bag
      </h1>

      {%- if cart.item_count > 0 -%}
        <form action="{{ routes.cart_url }}" method="post" id="CartPageForm">
          <div style="border-top: 1px solid var(--color-border-subtle); margin-bottom: 32px;">
            {%- for item in cart.items -%}
              <div class="cart-item" style="padding: 24px 0;">
                <img src="{{ item.image | image_url: width: 240 }}" alt="{{ item.title | escape }}" class="cart-item-img" width="80" height="100">
                <div class="cart-item-details">
                  <h3 class="cart-item-title"><a href="{{ item.url }}">{{ item.product.title }}</a></h3>
                  {%- unless item.product.has_only_default_variant -%}
                    <span class="cart-item-variant">{{ item.variant.title }}</span>
                  {%- endunless -%}
                  <span class="cart-item-price">{{ item.final_price | money }}</span>
                  <div class="cart-item-qty-stepper">
                    <button type="button" class="qty-btn" onclick="window.JatayuCart.updateQty('{{ item.key }}', {{ item.quantity | minus: 1 }})">-</button>
                    <input type="text" class="qty-input" value="{{ item.quantity }}" readonly aria-label="Quantity">
                    <button type="button" class="qty-btn" onclick="window.JatayuCart.updateQty('{{ item.key }}', {{ item.quantity | plus: 1 }})">+</button>
                  </div>
                </div>
                <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0" class="cart-item-remove">Remove</a>
              </div>
            {%- endfor -%}
          </div>

          <div style="background: var(--color-ivory-parchment); padding: 32px; border-radius: 4px; display: flex; flex-direction: column; gap: 16px; border: 1px solid var(--color-border-sand);">
            <div style="display: flex; justify-content: space-between; font-size: 18px; font-weight: 600;">
              <span>Total</span>
              <span style="color: var(--color-maroon-primary);">{{ cart.total_price | money }}</span>
            </div>
            <p style="font-size: 12px; color: rgba(33, 27, 25, 0.65);">
              Taxes and shipping calculated at checkout.
            </p>
            <button type="submit" name="checkout" class="btn btn-primary" style="width: 100%;">
              Proceed to Checkout
            </button>
          </div>
        </form>
      {%- else -%}
        <div style="text-align: center; padding: 64px 0;">
          <p style="font-size: 16px; color: rgba(33, 27, 25, 0.7); margin-bottom: 24px;">Your bag is currently empty.</p>
          <a href="/collections/all" class="btn btn-primary">Discover Creations</a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Cart Page",
  "settings": []
}
{% endschema %}
