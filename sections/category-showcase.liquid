{%- comment -%}
  SECTION 4 — Shop by Category
  Driven by merchant-selected collections.
  No hardcoded fake sample links.
{%- endcomment -%}

{%- assign col1 = section.settings.collection_1 -%}
{%- assign col2 = section.settings.collection_2 -%}

<section class="category-showcase-section" id="CategoryShowcase-{{ section.id }}" aria-label="Shop by Category">
  <div class="page-width">
    <div class="section-header-row">
      <div class="section-title-wrap">
        {%- if section.settings.eyebrow != blank -%}
          <span class="label-eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h2 class="section-title">{{ section.settings.heading | default: 'Shop by Category' }}</h2>
      </div>
    </div>

    {%- if col1 != blank or col2 != blank -%}
      <div class="category-grid">
        {%- if col1 != blank -%}
          <a href="{{ col1.url }}" class="category-card" aria-label="{{ col1.title }}">
            {%- assign img1 = section.settings.cat1_image | default: col1.featured_image | default: col1.products.first.featured_image -%}
            {%- if img1 != blank -%}
              <img src="{{ img1 | image_url: width: 1000 }}" alt="{{ col1.title }}" class="category-card-img" loading="lazy" width="600" height="750">
            {%- else -%}
              <div style="width: 100%; height: 100%; background: var(--color-beige-sand);"></div>
            {%- endif -%}
            <div class="category-card-overlay">
              <h3 class="category-card-title">{{ col1.title }}</h3>
              <span class="category-card-link">
                <span>Explore Collection</span>
                {% render 'icon-arrow' %}
              </span>
            </div>
          </a>
        {%- endif -%}

        {%- if col2 != blank -%}
          <a href="{{ col2.url }}" class="category-card" aria-label="{{ col2.title }}">
            {%- assign img2 = section.settings.cat2_image | default: col2.featured_image | default: col2.products.first.featured_image -%}
            {%- if img2 != blank -%}
              <img src="{{ img2 | image_url: width: 1000 }}" alt="{{ col2.title }}" class="category-card-img" loading="lazy" width="600" height="750">
            {%- else -%}
              <div style="width: 100%; height: 100%; background: var(--color-maroon-primary);"></div>
            {%- endif -%}
            <div class="category-card-overlay">
              <h3 class="category-card-title">{{ col2.title }}</h3>
              <span class="category-card-link">
                <span>Explore Collection</span>
                {% render 'icon-arrow' %}
              </span>
            </div>
          </a>
        {%- endif -%}
      </div>
    {%- elsif request.design_mode -%}
      <div style="text-align: center; padding: 48px 20px; background: rgba(116, 1, 1, 0.04); border: 1px dashed var(--color-border-subtle); border-radius: 6px;">
        <h3 style="font-family: var(--font-editorial); font-size: 20px; color: var(--color-maroon-primary); margin-bottom: 8px;">
          Category Showcase
        </h3>
        <p style="font-size: 13px; color: var(--color-text-body); max-width: 480px; margin: 0 auto;">
          Select your two featured collections in the settings panel to display them side-by-side.
        </p>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Category Showcase",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "CRAFTED SILHOUETTES"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Category"
    },
    {
      "type": "header",
      "content": "Category 1"
    },
    {
      "type": "collection",
      "id": "collection_1",
      "label": "First Collection"
    },
    {
      "type": "image_picker",
      "id": "cat1_image",
      "label": "Custom Image (optional)"
    },
    {
      "type": "header",
      "content": "Category 2"
    },
    {
      "type": "collection",
      "id": "collection_2",
      "label": "Second Collection"
    },
    {
      "type": "image_picker",
      "id": "cat2_image",
      "label": "Custom Image (optional)"
    }
  ],
  "presets": [
    {
      "name": "Category Showcase"
    }
  ]
}
{% endschema %}
