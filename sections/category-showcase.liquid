{%- comment -%}
  SECTION 4 — Shop by Category
  Editorial category showcase: T-SHIRTS & HOODIES
{%- endcomment -%}

<section class="category-showcase-section" id="CategoryShowcase" aria-label="Shop by Category">
  <div class="page-width">
    <div class="section-header-row">
      <div class="section-title-wrap">
        <span class="label-eyebrow">{{ section.settings.eyebrow | default: 'CRAFTED SILHOUETTES' }}</span>
        <h2>{{ section.settings.heading | default: 'Shop by Category' }}</h2>
      </div>
    </div>

    <div class="category-grid">
      <!-- Category 1: T-Shirts -->
      <a href="{{ section.settings.cat1_link | default: '/collections/t-shirts' }}" class="category-card" aria-label="Explore T-Shirts Collection">
        {%- if section.settings.cat1_image != blank -%}
          <img src="{{ section.settings.cat1_image | image_url: width: 1000 }}" alt="JATAYU T-Shirts" class="category-card-img" loading="lazy" width="600" height="750">
        {%- else -%}
          <img src="{{ 'category-tshirts.jpg' | asset_url }}" alt="JATAYU T-Shirts Editorial" class="category-card-img" loading="lazy" width="600" height="750">
        {%- endif -%}
        <div class="category-card-overlay">
          <h3 class="category-card-title">{{ section.settings.cat1_title | default: 'T-Shirts' }}</h3>
          <span class="category-card-link">
            <span>Explore Collection</span>
            {% render 'icon-arrow' %}
          </span>
        </div>
      </a>

      <!-- Category 2: Hoodies -->
      <a href="{{ section.settings.cat2_link | default: '/collections/hoodies' }}" class="category-card" aria-label="Explore Hoodies Collection">
        {%- if section.settings.cat2_image != blank -%}
          <img src="{{ section.settings.cat2_image | image_url: width: 1000 }}" alt="JATAYU Hoodies" class="category-card-img" loading="lazy" width="600" height="750">
        {%- else -%}
          <img src="{{ 'category-hoodies.jpg' | asset_url }}" alt="JATAYU Hoodies Editorial" class="category-card-img" loading="lazy" width="600" height="750">
        {%- endif -%}
        <div class="category-card-overlay">
          <h3 class="category-card-title">{{ section.settings.cat2_title | default: 'Hoodies' }}</h3>
          <span class="category-card-link">
            <span>Explore Collection</span>
            {% render 'icon-arrow' %}
          </span>
        </div>
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Category Showcase",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "CRAFTED SILHOUETTES"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Category"
    },
    {
      "type": "header",
      "content": "Category 1"
    },
    {
      "type": "text",
      "id": "cat1_title",
      "label": "Title",
      "default": "T-Shirts"
    },
    {
      "type": "image_picker",
      "id": "cat1_image",
      "label": "Image"
    },
    {
      "type": "url",
      "id": "cat1_link",
      "label": "Link",
      "default": "/collections/t-shirts"
    },
    {
      "type": "header",
      "content": "Category 2"
    },
    {
      "type": "text",
      "id": "cat2_title",
      "label": "Title",
      "default": "Hoodies"
    },
    {
      "type": "image_picker",
      "id": "cat2_image",
      "label": "Image"
    },
    {
      "type": "url",
      "id": "cat2_link",
      "label": "Link",
      "default": "/collections/hoodies"
    }
  ],
  "presets": [
    {
      "name": "Category Showcase"
    }
  ]
}
{% endschema %}
