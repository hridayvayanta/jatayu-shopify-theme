{%- comment -%}
  SECTION 6 — Brand Story
  "A Legacy Woven Into Every Thread."
  Editorial split layout with brand narrative and campaign imagery.
{%- endcomment -%}

<section class="brand-story-section" id="BrandStorySection" aria-label="Brand Story">
  <div class="page-width">
    <div class="brand-story-grid">
      <!-- Story Content -->
      <div class="brand-story-content">
        {%- if section.settings.eyebrow != blank -%}
          <span class="label-eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        
        <h2 class="brand-story-title">{{ section.settings.heading | default: 'A Legacy Woven Into Every Thread.' }}</h2>
        
        <div class="brand-story-text">
          {%- if section.settings.text_paragraph_1 != blank -%}
            <p>{{ section.settings.text_paragraph_1 }}</p>
          {%- endif -%}
          {%- if section.settings.text_paragraph_2 != blank -%}
            <p style="margin-top: 16px;">{{ section.settings.text_paragraph_2 }}</p>
          {%- endif -%}
        </div>

        {%- if section.settings.cta_text != blank and section.settings.cta_link != blank -%}
          <div style="margin-top: 24px;">
            <a href="{{ section.settings.cta_link }}" class="btn btn-secondary">
              {{ section.settings.cta_text }}
            </a>
          </div>
        {%- endif -%}
      </div>

      <!-- Story Imagery -->
      <div class="brand-story-media">
        {%- if section.settings.image != blank -%}
          <img
            src="{{ section.settings.image | image_url: width: 1200 }}"
            alt="{{ section.settings.heading | escape }}"
            class="brand-story-img"
            loading="lazy"
            width="600"
            height="700"
          >
        {%- else -%}
          <img
            src="{{ 'story-heritage.jpg' | asset_url }}"
            alt="JATAYU Heritage Campaign"
            class="brand-story-img"
            loading="lazy"
            width="600"
            height="700"
          >
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Brand Story",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "HERITAGE & VISION"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A Legacy Woven Into Every Thread."
    },
    {
      "type": "textarea",
      "id": "text_paragraph_1",
      "label": "Paragraph 1",
      "default": "Inspired by Jatayu's courage and sacrifice in the Ramayana, JATAYU brings the spirit of Indian heritage into contemporary fashion."
    },
    {
      "type": "textarea",
      "id": "text_paragraph_2",
      "label": "Paragraph 2",
      "default": "An expression of identity, courage, and a legacy worth carrying forward."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Editorial Image"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button Label",
      "default": "DISCOVER OUR STORY"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Brand Story"
    }
  ]
}
{% endschema %}
