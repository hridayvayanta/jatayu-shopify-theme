{%- comment -%}
  JATAYU Luxury Fashion — Reset Customer Password
{%- endcomment -%}

<section class="customer-account-section" style="padding: clamp(60px, 8vw, 120px) 0; margin-top: var(--header-height);">
  <div class="page-width">
    <div class="customer-auth-container" style="max-width: 480px; margin: 0 auto; background: var(--color-ivory-parchment); border: 1px solid var(--color-border-sand); padding: clamp(32px, 5vw, 48px); border-radius: 4px;">
      
      <div style="text-align: center; margin-bottom: 32px;">
        <span class="label-eyebrow">SANCTUARY SECURITY</span>
        <h1 class="heading-section" style="color: var(--color-maroon-primary); margin-top: 6px;">Reset Password</h1>
        <p style="font-size: 14px; color: rgba(33, 27, 25, 0.7); margin-top: 8px;">Enter your new password below.</p>
      </div>

      {%- form 'reset_customer_password', class: 'auth-form' -%}
        {%- if form.errors -%}
          <div class="auth-errors" style="background: rgba(116, 1, 1, 0.08); border-left: 3px solid var(--color-maroon-primary); padding: 12px 16px; margin-bottom: 24px; font-size: 13px; color: var(--color-maroon-primary);">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div class="form-group" style="margin-bottom: 16px;">
          <label for="ResetPassword" class="form-label" style="display: block; font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 8px; font-weight: 600;">New Password</label>
          <input
            type="password"
            name="customer[password]"
            id="ResetPassword"
            autocomplete="new-password"
            required
            class="auth-input"
            style="width: 100%; padding: 12px 16px; border: 1px solid var(--color-border-subtle); background: var(--color-ivory-warm); font-family: inherit; font-size: 14px; color: var(--color-text-body); outline: none; border-radius: 2px;"
          >
        </div>

        <div class="form-group" style="margin-bottom: 24px;">
          <label for="PasswordConfirmation" class="form-label" style="display: block; font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 8px; font-weight: 600;">Confirm Password</label>
          <input
            type="password"
            name="customer[password_confirmation]"
            id="PasswordConfirmation"
            autocomplete="new-password"
            required
            class="auth-input"
            style="width: 100%; padding: 12px 16px; border: 1px solid var(--color-border-subtle); background: var(--color-ivory-warm); font-family: inherit; font-size: 14px; color: var(--color-text-body); outline: none; border-radius: 2px;"
          >
        </div>

        <button type="submit" class="btn btn-primary" style="width: 100%; justify-content: center;">
          Reset Password
        </button>
      {%- endform -%}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Reset Password",
  "settings": []
}
{% endschema %}
