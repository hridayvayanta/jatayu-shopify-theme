{%- comment -%}
  SECTION 3 — Featured Collection
  "The First Chapter." — THE JATAYU COLLECTION
{%- endcomment -%}

<section class="featured-collection-section" id="FeaturedCollection" aria-label="Featured Collection">
  <div class="page-width">
    <div class="section-header-row">
      <div class="section-title-wrap">
        <span class="label-eyebrow">{{ section.settings.eyebrow | default: 'THE JATAYU COLLECTION' }}</span>
        <h2>{{ section.settings.heading | default: 'The First Chapter.' }}</h2>
      </div>
      <div>
        <a href="{{ section.settings.collection.url | default: '/collections/all' }}" class="btn-text-arrow">
          <span>View All Pieces</span>
          {% render 'icon-arrow' %}
        </a>
      </div>
    </div>

    <div class="product-grid">
      {%- if section.settings.collection != blank and section.settings.collection.products_count > 0 -%}
        {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        {%- comment -%} High-fashion default catalog items {%- endcomment -%}
        <article class="product-card">
          <div class="product-card-media">
            <a href="/products/jatayu-sovereign-oversized-tee-charcoal">
              <img src="{{ 'product-tee-charcoal-front.jpg' | asset_url }}" alt="Jatayu Sovereign Oversized Tee - Vintage Charcoal" class="product-card-img product-card-img-primary" width="400" height="500">
              <img src="{{ 'product-tee-charcoal-back.jpg' | asset_url }}" alt="Jatayu Sovereign Oversized Tee Back View" class="product-card-img product-card-img-secondary" width="400" height="500">
            </a>
            <span class="product-badge">New Chapter</span>
            <button type="button" class="quick-add-btn" data-variant-id="101" aria-label="Quick Add">
              {% render 'icon-bag' %}
              <span>Quick Add</span>
            </button>
          </div>
          <div class="product-card-info">
            <h3 class="product-card-title"><a href="/products/jatayu-sovereign-oversized-tee-charcoal">The Jatayu Sovereign Oversized Tee</a></h3>
            <div class="product-card-price">₹2,499</div>
            <div class="product-card-swatches">
              <span class="swatch-dot" style="background-color: #211B19;" title="Vintage Charcoal"></span>
              <span class="swatch-dot" style="background-color: #F7DBBD;" title="Peach Ivory"></span>
              <span class="swatch-dot" style="background-color: #740101;" title="Heritage Maroon"></span>
            </div>
          </div>
        </article>

        <article class="product-card">
          <div class="product-card-media">
            <a href="/products/jatayu-sovereign-oversized-tee-ivory">
              <img src="{{ 'product-tee-ivory-front.jpg' | asset_url }}" alt="The Jatayu Sovereign Oversized Tee - Peach Ivory" class="product-card-img product-card-img-primary" width="400" height="500">
              <img src="{{ 'product-tee-ivory-back.jpg' | asset_url }}" alt="The Jatayu Sovereign Oversized Tee Back View" class="product-card-img product-card-img-secondary" width="400" height="500">
            </a>
            <button type="button" class="quick-add-btn" data-variant-id="102" aria-label="Quick Add">
              {% render 'icon-bag' %}
              <span>Quick Add</span>
            </button>
          </div>
          <div class="product-card-info">
            <h3 class="product-card-title"><a href="/products/jatayu-sovereign-oversized-tee-ivory">The Jatayu Sovereign Oversized Tee</a></h3>
            <div class="product-card-price">₹2,499</div>
            <div class="product-card-swatches">
              <span class="swatch-dot" style="background-color: #F7DBBD;" title="Peach Ivory"></span>
              <span class="swatch-dot" style="background-color: #211B19;" title="Vintage Charcoal"></span>
            </div>
          </div>
        </article>

        <article class="product-card">
          <div class="product-card-media">
            <a href="/products/sacred-flight-heavyweight-hoodie-maroon">
              <img src="{{ 'product-hoodie-maroon-front.jpg' | asset_url }}" alt="Sacred Flight Heavyweight Hoodie - Deep Maroon" class="product-card-img product-card-img-primary" width="400" height="500">
              <img src="{{ 'product-hoodie-maroon-back.jpg' | asset_url }}" alt="Sacred Flight Heavyweight Hoodie Back View" class="product-card-img product-card-img-secondary" width="400" height="500">
            </a>
            <span class="product-badge">Signature</span>
            <button type="button" class="quick-add-btn" data-variant-id="103" aria-label="Quick Add">
              {% render 'icon-bag' %}
              <span>Quick Add</span>
            </button>
          </div>
          <div class="product-card-info">
            <h3 class="product-card-title"><a href="/products/sacred-flight-heavyweight-hoodie-maroon">Sacred Flight Heavyweight Hoodie</a></h3>
            <div class="product-card-price">₹4,299</div>
            <div class="product-card-swatches">
              <span class="swatch-dot" style="background-color: #740101;" title="Deep Maroon"></span>
              <span class="swatch-dot" style="background-color: #211B19;" title="Vintage Charcoal"></span>
            </div>
          </div>
        </article>

        <article class="product-card">
          <div class="product-card-media">
            <a href="/products/garuda-crest-heavyweight-tee">
              <img src="{{ 'product-tee-maroon-front.jpg' | asset_url }}" alt="Garuda Crest Heavyweight Tee - Heritage Maroon" class="product-card-img product-card-img-primary" width="400" height="500">
              <img src="{{ 'product-tee-maroon-back.jpg' | asset_url }}" alt="Garuda Crest Heavyweight Tee Back View" class="product-card-img product-card-img-secondary" width="400" height="500">
            </a>
            <button type="button" class="quick-add-btn" data-variant-id="104" aria-label="Quick Add">
              {% render 'icon-bag' %}
              <span>Quick Add</span>
            </button>
          </div>
          <div class="product-card-info">
            <h3 class="product-card-title"><a href="/products/garuda-crest-heavyweight-tee">Garuda Crest Heavyweight Tee</a></h3>
            <div class="product-card-price">₹2,299</div>
            <div class="product-card-swatches">
              <span class="swatch-dot" style="background-color: #740101;" title="Heritage Maroon"></span>
              <span class="swatch-dot" style="background-color: #E9C39E;" title="Sand Beige"></span>
            </div>
          </div>
        </article>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Collection",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "THE JATAYU COLLECTION"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The First Chapter."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 12,
      "step": 2,
      "default": 4,
      "label": "Maximum products to show"
    }
  ],
  "presets": [
    {
      "name": "Featured Collection"
    }
  ]
}
{% endschema %}
