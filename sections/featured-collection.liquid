{%- comment -%}
  SECTION 3 — Featured Collection
  Renders real Shopify products from the selected collection.
  No fake sample products.
{%- endcomment -%}

{%- assign collection = section.settings.collection -%}

<section class="featured-collection-section" id="FeaturedCollection-{{ section.id }}" aria-label="Featured Collection">
  <div class="page-width">
    <div class="section-header-row">
      <div class="section-title-wrap">
        {%- if section.settings.eyebrow != blank -%}
          <span class="label-eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h2 class="section-title">{{ section.settings.heading | default: collection.title | default: 'Featured Collection' }}</h2>
      </div>
      {%- if collection != blank and collection.all_products_count > 0 -%}
        <div>
          <a href="{{ collection.url }}" class="view-all-link">
            <span>View All</span>
            {% render 'icon-arrow' %}
          </a>
        </div>
      {%- endif -%}
    </div>

    {%- if collection != blank and collection.products_count > 0 -%}
      <div class="product-grid">
        {%- for product in collection.products limit: section.settings.products_to_show -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      </div>
    {%- elsif request.design_mode -%}
      <!-- Theme Editor Setup Guide (Only visible to merchant inside theme editor) -->
      <div style="text-align: center; padding: 48px 20px; background: rgba(116, 1, 1, 0.04); border: 1px dashed var(--color-border-subtle); border-radius: 6px;">
        <h3 style="font-family: var(--font-editorial); font-size: 20px; color: var(--color-maroon-primary); margin-bottom: 8px;">
          No Collection Selected
        </h3>
        <p style="font-size: 13px; color: var(--color-text-body); max-width: 480px; margin: 0 auto;">
          Select a collection in the settings panel on the right/left to display your store's live products here.
        </p>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured Collection",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "THE JATAYU COLLECTION"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The First Chapter."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 16,
      "step": 2,
      "default": 4,
      "label": "Products to show"
    }
  ],
  "presets": [
    {
      "name": "Featured Collection"
    }
  ]
}
{% endschema %}
