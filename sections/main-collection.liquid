{%- comment -%}
  JATAYU Luxury Fashion — Main Collection Section
  Minimalist editorial collection header, sorting & filtering, 4-col responsive product grid.
{%- endcomment -%}

<section class="collection-page-section" style="padding: clamp(40px, 6vw, 80px) 0 clamp(60px, 8vw, 120px); margin-top: var(--header-height);">
  <div class="page-width">
    <!-- Collection Editorial Header -->
    <div style="text-align: center; max-width: 800px; margin: 0 auto 48px;">
      <span class="label-eyebrow">THE ARCHIVE</span>
      <h1 class="display-large" style="color: var(--color-maroon-primary); margin-bottom: 16px;">
        {{ collection.title | default: 'All Creations' }}
      </h1>
      {%- if collection.description != blank -%}
        <p class="body-lead" style="margin: 0 auto; color: rgba(33, 27, 25, 0.8);">
          {{ collection.description }}
        </p>
      {%- else -%}
        <p class="body-lead" style="margin: 0 auto; color: rgba(33, 27, 25, 0.8);">
          Contemporary silhouettes infused with timeless courage and cultural legacy.
        </p>
      {%- endif -%}
    </div>

    <!-- Filter & Sort Bar -->
    <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--color-border-subtle); padding-bottom: 16px; margin-bottom: 36px; font-size: 13px; text-transform: uppercase; letter-spacing: 0.1em;">
      <div>
        <span>{{ collection.products_count | default: 6 }} Pieces</span>
      </div>

      <div style="display: flex; gap: 20px; align-items: center;">
        <label for="SortBy" style="color: rgba(33, 27, 25, 0.7);">Sort By:</label>
        <select id="SortBy" name="sort_by" style="background: transparent; border: 1px solid var(--color-border-subtle); padding: 6px 12px; font-family: inherit; font-size: 12px; color: var(--color-text-body); outline: none;">
          <option value="manual">Featured</option>
          <option value="price-ascending">Price: Low to High</option>
          <option value="price-descending">Price: High to Low</option>
          <option value="created-descending">Newest First</option>
        </select>
      </div>
    </div>

    <!-- Collection Product Grid -->
    <div class="product-grid">
      {%- if collection.products.size > 0 -%}
        {%- for product in collection.products -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        <!-- Fallback Catalog Items -->
        {%- render 'product-card', product: null -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection Page",
  "settings": []
}
{% endschema %}
