{%- comment -%}
  JATAYU Luxury Fashion — Size Guide Section
  Precise sizing charts for Oversized T-Shirts, Standard Crew, and Hoodies
{%- endcomment -%}

<section class="size-guide-section" style="padding: clamp(60px, 8vw, 120px) 0; margin-top: var(--header-height);">
  <div class="page-width">
    <div style="max-width: 900px; margin: 0 auto;">
      <div style="text-align: center; margin-bottom: 48px;">
        <span class="label-eyebrow">FIT & DIMENSIONS</span>
        <h1 class="heading-section" style="color: var(--color-maroon-primary); margin-bottom: 16px;">
          Comprehensive Size Guide
        </h1>
        <p style="color: rgba(33, 27, 25, 0.8);">
          All measurements are in inches. For the ideal silhouette, compare with a favorite garment in your wardrobe.
        </p>
      </div>

      <!-- Chart 1: Oversized T-Shirts -->
      <div style="margin-bottom: 48px; background: var(--color-offwhite); padding: 32px; border: 1px solid var(--color-border-subtle); border-radius: 4px;">
        <h3 style="font-family: var(--font-editorial); font-size: 24px; color: var(--color-maroon-primary); margin-bottom: 16px;">
          Oversized Heavyweight T-Shirt (240 GSM)
        </h3>
        <p style="font-size: 13px; color: rgba(33, 27, 25, 0.7); margin-bottom: 20px;">
          Relaxed shoulder drop, broad chest, tailored sleeve length.
        </p>

        <div style="overflow-x: auto;">
          <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 14px;">
            <thead>
              <tr style="border-bottom: 2px solid var(--color-maroon-primary); color: var(--color-maroon-primary);">
                <th style="padding: 12px 16px;">Size</th>
                <th style="padding: 12px 16px;">Chest (Width)</th>
                <th style="padding: 12px 16px;">Length</th>
                <th style="padding: 12px 16px;">Shoulder</th>
                <th style="padding: 12px 16px;">Sleeve</th>
              </tr>
            </thead>
            <tbody>
              <tr style="border-bottom: 1px solid var(--color-border-subtle);"><td style="padding: 12px 16px; font-weight: 600;">S</td><td style="padding: 12px 16px;">42"</td><td style="padding: 12px 16px;">28"</td><td style="padding: 12px 16px;">20.5"</td><td style="padding: 12px 16px;">9.0"</td></tr>
              <tr style="border-bottom: 1px solid var(--color-border-subtle);"><td style="padding: 12px 16px; font-weight: 600;">M</td><td style="padding: 12px 16px;">44"</td><td style="padding: 12px 16px;">29"</td><td style="padding: 12px 16px;">21.5"</td><td style="padding: 12px 16px;">9.5"</td></tr>
              <tr style="border-bottom: 1px solid var(--color-border-subtle);"><td style="padding: 12px 16px; font-weight: 600;">L</td><td style="padding: 12px 16px;">46"</td><td style="padding: 12px 16px;">30"</td><td style="padding: 12px 16px;">22.5"</td><td style="padding: 12px 16px;">10.0"</td></tr>
              <tr style="border-bottom: 1px solid var(--color-border-subtle);"><td style="padding: 12px 16px; font-weight: 600;">XL</td><td style="padding: 12px 16px;">48"</td><td style="padding: 12px 16px;">31"</td><td style="padding: 12px 16px;">23.5"</td><td style="padding: 12px 16px;">10.5"</td></tr>
              <tr><td style="padding: 12px 16px; font-weight: 600;">XXL</td><td style="padding: 12px 16px;">50"</td><td style="padding: 12px 16px;">32"</td><td style="padding: 12px 16px;">24.5"</td><td style="padding: 12px 16px;">11.0"</td></tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Chart 2: Pullover Hoodie -->
      <div style="background: var(--color-offwhite); padding: 32px; border: 1px solid var(--color-border-subtle); border-radius: 4px;">
        <h3 style="font-family: var(--font-editorial); font-size: 24px; color: var(--color-maroon-primary); margin-bottom: 16px;">
          Sacred Flight Heavyweight Hoodie (400 GSM)
        </h3>
        <p style="font-size: 13px; color: rgba(33, 27, 25, 0.7); margin-bottom: 20px;">
          Structural double-layered hood, ribbed cuffs and hem, kangaroo pocket.
        </p>

        <div style="overflow-x: auto;">
          <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 14px;">
            <thead>
              <tr style="border-bottom: 2px solid var(--color-maroon-primary); color: var(--color-maroon-primary);">
                <th style="padding: 12px 16px;">Size</th>
                <th style="padding: 12px 16px;">Chest (Circumference)</th>
                <th style="padding: 12px 16px;">Length</th>
                <th style="padding: 12px 16px;">Sleeve Length</th>
              </tr>
            </thead>
            <tbody>
              <tr style="border-bottom: 1px solid var(--color-border-subtle);"><td style="padding: 12px 16px; font-weight: 600;">S</td><td style="padding: 12px 16px;">42"</td><td style="padding: 12px 16px;">27.5"</td><td style="padding: 12px 16px;">25.0"</td></tr>
              <tr style="border-bottom: 1px solid var(--color-border-subtle);"><td style="padding: 12px 16px; font-weight: 600;">M</td><td style="padding: 12px 16px;">44"</td><td style="padding: 12px 16px;">28.5"</td><td style="padding: 12px 16px;">25.5"</td></tr>
              <tr style="border-bottom: 1px solid var(--color-border-subtle);"><td style="padding: 12px 16px; font-weight: 600;">L</td><td style="padding: 12px 16px;">46"</td><td style="padding: 12px 16px;">29.5"</td><td style="padding: 12px 16px;">26.0"</td></tr>
              <tr style="border-bottom: 1px solid var(--color-border-subtle);"><td style="padding: 12px 16px; font-weight: 600;">XL</td><td style="padding: 12px 16px;">48"</td><td style="padding: 12px 16px;">30.5"</td><td style="padding: 12px 16px;">26.5"</td></tr>
              <tr><td style="padding: 12px 16px; font-weight: 600;">XXL</td><td style="padding: 12px 16px;">50"</td><td style="padding: 12px 16px;">31.5"</td><td style="padding: 12px 16px;">27.0"</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Size Guide",
  "settings": []
}
{% endschema %}
