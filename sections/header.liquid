<header class="site-header" id="SiteHeader">
  <div class="header-container">
    <!-- Desktop Left Navigation -->
    <nav class="header-nav-left" role="navigation" aria-label="Main Navigation">
      <a href="{{ section.settings.link_shop | default: '/collections/all' }}" class="nav-link">Shop</a>
      <a href="{{ section.settings.link_collections | default: '/collections' }}" class="nav-link">Collections</a>
      <a href="{{ section.settings.link_story | default: '/pages/our-story' }}" class="nav-link">Our Story</a>
    </nav>

    <!-- Mobile Menu Trigger -->
    <button type="button" class="mobile-menu-toggle" aria-label="Open Navigation Menu" aria-controls="mobile-nav-drawer">
      {% render 'icon-menu' %}
    </button>

    <!-- Center Logo (Official Approved JATAYU Logo) -->
    <div class="header-logo-center">
      <a href="/" class="header-logo-link" aria-label="JATAYU Home">
        {%- if section.settings.logo != blank -%}
          <img
            src="{{ section.settings.logo | image_url: width: 300 }}"
            alt="{{ shop.name }}"
            class="header-logo-img"
            width="150"
            height="52"
          >
        {%- else -%}
          <img
            src="{{ 'jatayu-logo-transparent.png' | asset_url }}"
            onerror="this.onerror=null; this.src='{{ 'jatayu-logo.jpg' | asset_url }}';"
            alt="JATAYU"
            class="header-logo-img"
            width="150"
            height="52"
          >
        {%- endif -%}
      </a>
    </div>

    <!-- Right Actions: Search, Account, Shopping Bag -->
    <div class="header-actions-right">
      <a href="/search" class="header-action-btn" aria-label="Search Store" id="SearchTrigger">
        {% render 'icon-search' %}
      </a>

      {%- if shop.customer_accounts_enabled -%}
        <a href="{% if customer %}/account{% else %}/account/login{% endif %}" class="header-action-btn" aria-label="Customer Account">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
        </a>
      {%- endif -%}

      <a href="/cart" class="header-action-btn" aria-label="Shopping Bag" data-cart-open>
        {% render 'icon-bag' %}
        <span class="header-cart-count" style="display: {% if cart.item_count > 0 %}flex{% else %}none{% endif %};">
          {{ cart.item_count }}
        </span>
      </a>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Custom Logo Image"
    },
    {
      "type": "url",
      "id": "link_shop",
      "label": "Shop link",
      "default": "/collections/all"
    },
    {
      "type": "url",
      "id": "link_collections",
      "label": "Collections link"
    },
    {
      "type": "url",
      "id": "link_story",
      "label": "Our Story link"
    }
  ]
}
{% endschema %}
