{%- comment -%}
  JATAYU Luxury Fashion — Generic Page Template Section
{%- endcomment -%}

<section class="main-page-section" style="padding: clamp(60px, 8vw, 120px) 0; margin-top: var(--header-height);">
  <div class="page-width">
    <div style="max-width: 820px; margin: 0 auto;">
      <h1 class="heading-section" style="color: var(--color-maroon-primary); margin-bottom: 32px; text-align: center;">
        {{ page.title }}
      </h1>
      <div class="page-content" style="font-size: 15px; line-height: 1.8; color: var(--color-text-body);">
        {{ page.content }}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Page Content",
  "settings": []
}
{% endschema %}
